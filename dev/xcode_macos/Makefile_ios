# OneLoneCoder Pixel Game Engine 3 (olcPGE3) iOS Makefile
# This makefile builds the PGE3 library and test executable for iOS devices and simulator

# Compiler and flags
CXX = clang++
CXXFLAGS_COMMON = -std=c++20 -Wall -Wextra -O2 -DGL_SILENCE_DEPRECATION -DTARGET_OS_IOS=1
DEBUG_CXXFLAGS_COMMON = -std=c++20 -Wall -Wextra -g -DGL_SILENCE_DEPRECATION -DDEBUG -DTARGET_OS_IOS=1

# iOS SDK and deployment target
IOS_SDK = iphoneos
IOS_SIM_SDK = iphonesimulator
IOS_MIN_VERSION = 15.0

# iOS-specific flags
IOS_FLAGS = -isysroot $(shell xcrun --sdk $(IOS_SDK) --show-sdk-path) -mios-version-min=$(IOS_MIN_VERSION)
IOS_SIM_FLAGS = -isysroot $(shell xcrun --sdk $(IOS_SIM_SDK) --show-sdk-path) -mios-simulator-version-min=$(IOS_MIN_VERSION)

# Architecture-specific flags for iOS
ARM64_IOS_FLAGS = -arch arm64 $(IOS_FLAGS)
X86_64_SIM_FLAGS = -arch x86_64 $(IOS_SIM_FLAGS)
ARM64_SIM_FLAGS = -arch arm64 $(IOS_SIM_FLAGS)

# Final flags
CXXFLAGS_ARM64_IOS = $(CXXFLAGS_COMMON) $(ARM64_IOS_FLAGS)
CXXFLAGS_X86_64_SIM = $(CXXFLAGS_COMMON) $(X86_64_SIM_FLAGS)
CXXFLAGS_ARM64_SIM = $(CXXFLAGS_COMMON) $(ARM64_SIM_FLAGS)
DEBUG_CXXFLAGS_ARM64_IOS = $(DEBUG_CXXFLAGS_COMMON) $(ARM64_IOS_FLAGS)
DEBUG_CXXFLAGS_X86_64_SIM = $(DEBUG_CXXFLAGS_COMMON) $(X86_64_SIM_FLAGS)
DEBUG_CXXFLAGS_ARM64_SIM = $(DEBUG_CXXFLAGS_COMMON) $(ARM64_SIM_FLAGS)

# Directories
SRC_DIR = ../src
TEST_DIR = ../tests
BIN_DIR = bin_ios
BUILD_DIR = build_ios
BUILD_ARM64_IOS_DIR = build_ios/arm64-ios
BUILD_X86_64_SIM_DIR = build_ios/x86_64-simulator
BUILD_ARM64_SIM_DIR = build_ios/arm64-simulator
BUILD_DEBUG_DIR = build_ios/debug

# Include directories
INCLUDES = -I$(SRC_DIR)

# Source files - platform-specific selection
CORE_SOURCES = $(SRC_DIR)/core.cpp \
               $(SRC_DIR)/window.cpp \
               $(SRC_DIR)/image.cpp \
               $(SRC_DIR)/draw2d.cpp \
			   $(SRC_DIR)/draw2d_sw.cpp \
               $(SRC_DIR)/hw_mouse.cpp \
               $(SRC_DIR)/gpu_iface.cpp \
               $(SRC_DIR)/gpu_opengl33.cpp \
               $(SRC_DIR)/api_opengl.cpp \
               $(SRC_DIR)/font.cpp

# Platform-specific sources for iOS
PLATFORM_SOURCES = $(SRC_DIR)/api_macos.cpp \
                   $(SRC_DIR)/host_apple_ios.cpp \
                   $(SRC_DIR)/imload_macos.cpp

# All library sources
LIB_SOURCES = $(CORE_SOURCES) $(PLATFORM_SOURCES)

# iOS system libraries
LIBS_IOS = -framework UIKit -framework OpenGLES -framework QuartzCore -framework CoreGraphics -framework Foundation -lobjc
LIBS_SIM = $(LIBS_IOS)

# Test source files
TEST_MAIN_SOURCE = $(TEST_DIR)/test_mh.cpp

# All sources for final executable
ALL_SOURCES = $(LIB_SOURCES) $(TEST_MAIN_SOURCE)

# Object files for different architectures
ARM64_IOS_OBJECTS = $(patsubst $(SRC_DIR)/%.cpp,$(BUILD_ARM64_IOS_DIR)/%.o,$(LIB_SOURCES)) \
                    $(patsubst $(TEST_DIR)/%.cpp,$(BUILD_ARM64_IOS_DIR)/%.o,$(TEST_MAIN_SOURCE))

X86_64_SIM_OBJECTS = $(patsubst $(SRC_DIR)/%.cpp,$(BUILD_X86_64_SIM_DIR)/%.o,$(LIB_SOURCES)) \
                     $(patsubst $(TEST_DIR)/%.cpp,$(BUILD_X86_64_SIM_DIR)/%.o,$(TEST_MAIN_SOURCE))

ARM64_SIM_OBJECTS = $(patsubst $(SRC_DIR)/%.cpp,$(BUILD_ARM64_SIM_DIR)/%.o,$(LIB_SOURCES)) \
                    $(patsubst $(TEST_DIR)/%.cpp,$(BUILD_ARM64_SIM_DIR)/%.o,$(TEST_MAIN_SOURCE))

# Debug object files
DEBUG_OBJECTS = $(patsubst $(SRC_DIR)/%.cpp,$(BUILD_DEBUG_DIR)/%.o,$(LIB_SOURCES)) \
                $(patsubst $(TEST_DIR)/%.cpp,$(BUILD_DEBUG_DIR)/%.o,$(TEST_MAIN_SOURCE))

# Target names
TEST_EXECUTABLE = test_mh
ARM64_IOS_EXECUTABLE = $(BUILD_ARM64_IOS_DIR)/$(TEST_EXECUTABLE)
X86_64_SIM_EXECUTABLE = $(BUILD_X86_64_SIM_DIR)/$(TEST_EXECUTABLE)
ARM64_SIM_EXECUTABLE = $(BUILD_ARM64_SIM_DIR)/$(TEST_EXECUTABLE)
SIMULATOR_UNIVERSAL_EXECUTABLE = $(BIN_DIR)/$(TEST_EXECUTABLE)-simulator
IOS_EXECUTABLE = $(BIN_DIR)/$(TEST_EXECUTABLE)-ios
DEBUG_EXECUTABLE = $(BUILD_DEBUG_DIR)/$(TEST_EXECUTABLE)

# Default target - build iOS device binary
all: ios

# Help target
help:
	@echo "OneLoneCoder Pixel Game Engine 3 iOS Build System"
	@echo ""
	@echo "Available targets:"
	@echo "  all                - Build iOS device binary (default)"
	@echo "  ios                - Build ARM64 iOS device binary"
	@echo "  simulator          - Build universal iOS Simulator binary"
	@echo "  simulator-x86_64   - Build x86_64 iOS Simulator binary"
	@echo "  simulator-arm64    - Build ARM64 iOS Simulator binary"
	@echo "  debug              - Build debug version"
	@echo "  clean              - Remove all build files"
	@echo "  info               - Show build information"
	@echo "  help               - Show this help message"
	@echo ""
	@echo "Build configurations:"
	@echo "  iOS Device:           make ios"
	@echo "  iOS Simulator:        make simulator"
	@echo "  Simulator x86_64:     make simulator-x86_64"
	@echo "  Simulator ARM64:      make simulator-arm64"
	@echo "  Debug (Simulator):    make debug"
	@echo ""
	@echo "Note: iOS device builds require code signing and cannot be run directly."
	@echo "Use iOS Simulator builds for testing on the command line."

# Create build directories
$(BIN_DIR):
	@mkdir -p $(BIN_DIR)

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(BUILD_ARM64_IOS_DIR):
	@mkdir -p $(BUILD_ARM64_IOS_DIR)

$(BUILD_X86_64_SIM_DIR):
	@mkdir -p $(BUILD_X86_64_SIM_DIR)

$(BUILD_ARM64_SIM_DIR):
	@mkdir -p $(BUILD_ARM64_SIM_DIR)

$(BUILD_DEBUG_DIR):
	@mkdir -p $(BUILD_DEBUG_DIR)

# iOS device ARM64 executable
$(ARM64_IOS_EXECUTABLE): $(BUILD_ARM64_IOS_DIR) $(ARM64_IOS_OBJECTS)
	@echo "Linking iOS ARM64 executable: $@"
	$(CXX) $(CXXFLAGS_ARM64_IOS) -o $@ $(ARM64_IOS_OBJECTS) $(LIBS_IOS)
	@echo "iOS ARM64 executable created successfully!"

# iOS Simulator x86_64 executable
$(X86_64_SIM_EXECUTABLE): $(BUILD_X86_64_SIM_DIR) $(X86_64_SIM_OBJECTS)
	@echo "Linking iOS Simulator x86_64 executable: $@"
	$(CXX) $(CXXFLAGS_X86_64_SIM) -o $@ $(X86_64_SIM_OBJECTS) $(LIBS_SIM)
	@echo "iOS Simulator x86_64 executable created successfully!"

# iOS Simulator ARM64 executable
$(ARM64_SIM_EXECUTABLE): $(BUILD_ARM64_SIM_DIR) $(ARM64_SIM_OBJECTS)
	@echo "Linking iOS Simulator ARM64 executable: $@"
	$(CXX) $(CXXFLAGS_ARM64_SIM) -o $@ $(ARM64_SIM_OBJECTS) $(LIBS_SIM)
	@echo "iOS Simulator ARM64 executable created successfully!"

# iOS device binary (copy ARM64 iOS executable)
$(IOS_EXECUTABLE): $(ARM64_IOS_EXECUTABLE) $(BIN_DIR)
	@echo "Creating iOS device binary: $@"
	@cp $(ARM64_IOS_EXECUTABLE) $(IOS_EXECUTABLE)
	@echo "iOS device binary created successfully!"

# iOS Simulator universal binary (lipo both simulator architectures together)
$(SIMULATOR_UNIVERSAL_EXECUTABLE): $(X86_64_SIM_EXECUTABLE) $(ARM64_SIM_EXECUTABLE) $(BIN_DIR)
	@echo "Creating iOS Simulator universal binary: $@"
	lipo -create -output $@ $(X86_64_SIM_EXECUTABLE) $(ARM64_SIM_EXECUTABLE)
	@echo "iOS Simulator universal binary created successfully!"

# Debug executable (simulator-based for testing)
$(DEBUG_EXECUTABLE): $(BUILD_DEBUG_DIR) $(DEBUG_OBJECTS)
	@echo "Linking debug executable: $@"
	$(CXX) $(DEBUG_CXXFLAGS_ARM64_SIM) -o $@ $(DEBUG_OBJECTS) $(LIBS_SIM)
	@echo "Debug executable created successfully!"

# Compile source files for iOS device (ARM64)
$(BUILD_ARM64_IOS_DIR)/%.o: $(SRC_DIR)/%.cpp $(BUILD_ARM64_IOS_DIR)
	@echo "Compiling (iOS device ARM64): $<"
	$(CXX) $(CXXFLAGS_ARM64_IOS) $(INCLUDES) -c $< -o $@

$(BUILD_ARM64_IOS_DIR)/%.o: $(TEST_DIR)/%.cpp $(BUILD_ARM64_IOS_DIR)
	@echo "Compiling test (iOS device ARM64): $<"
	$(CXX) $(CXXFLAGS_ARM64_IOS) $(INCLUDES) -c $< -o $@

# Compile source files for iOS simulator (x86_64)
$(BUILD_X86_64_SIM_DIR)/%.o: $(SRC_DIR)/%.cpp $(BUILD_X86_64_SIM_DIR)
	@echo "Compiling (iOS x86_64 simulator): $<"
	$(CXX) $(CXXFLAGS_X86_64_SIM) $(INCLUDES) -c $< -o $@

$(BUILD_X86_64_SIM_DIR)/%.o: $(TEST_DIR)/%.cpp $(BUILD_X86_64_SIM_DIR)
	@echo "Compiling test (iOS x86_64 simulator): $<"
	$(CXX) $(CXXFLAGS_X86_64_SIM) $(INCLUDES) -c $< -o $@

# Compile source files for iOS simulator (ARM64)
$(BUILD_ARM64_SIM_DIR)/%.o: $(SRC_DIR)/%.cpp $(BUILD_ARM64_SIM_DIR)
	@echo "Compiling (iOS ARM64 simulator): $<"
	$(CXX) $(CXXFLAGS_ARM64_SIM) $(INCLUDES) -c $< -o $@

$(BUILD_ARM64_SIM_DIR)/%.o: $(TEST_DIR)/%.cpp $(BUILD_ARM64_SIM_DIR)
	@echo "Compiling test (iOS ARM64 simulator): $<"
	$(CXX) $(CXXFLAGS_ARM64_SIM) $(INCLUDES) -c $< -o $@

# Compile source files for debug
$(BUILD_DEBUG_DIR)/%.o: $(SRC_DIR)/%.cpp $(BUILD_DEBUG_DIR)
	@echo "Compiling (debug): $<"
	$(CXX) $(DEBUG_CXXFLAGS_ARM64_SIM) $(INCLUDES) -c $< -o $@

$(BUILD_DEBUG_DIR)/%.o: $(TEST_DIR)/%.cpp $(BUILD_DEBUG_DIR)
	@echo "Compiling test (debug): $<"
	$(CXX) $(DEBUG_CXXFLAGS_ARM64_SIM) $(INCLUDES) -c $< -o $@

# Architecture-specific targets
ios: $(IOS_EXECUTABLE)

simulator: $(SIMULATOR_UNIVERSAL_EXECUTABLE)

simulator-x86_64: $(X86_64_SIM_EXECUTABLE)

simulator-arm64: $(ARM64_SIM_EXECUTABLE)

debug: $(DEBUG_EXECUTABLE)

# Clean target
clean:
	@echo "Cleaning build files and output..."
	rm -rf $(BUILD_DIR) $(BIN_DIR)
	@echo "Clean complete!"

# Show build information
info:
	@echo "iOS Build Configuration:"
	@echo "  Compiler: $(CXX)"
	@echo "  Common Flags: $(CXXFLAGS_COMMON)"
	@echo "  iOS SDK: $(IOS_SDK) ($(shell xcrun --sdk $(IOS_SDK) --show-sdk-path))"
	@echo "  iOS Simulator SDK: $(IOS_SIM_SDK) ($(shell xcrun --sdk $(IOS_SIM_SDK) --show-sdk-path))"
	@echo "  iOS Minimum Version: $(IOS_MIN_VERSION)"
	@echo "  iOS ARM64 Flags: $(CXXFLAGS_ARM64_IOS)"
	@echo "  Simulator x86_64 Flags: $(CXXFLAGS_X86_64_SIM)"
	@echo "  Simulator ARM64 Flags: $(CXXFLAGS_ARM64_SIM)"
	@echo "  iOS Libraries: $(LIBS_IOS)"
	@echo "  Source Directory: $(SRC_DIR)"
	@echo "  Test Directory: $(TEST_DIR)"
	@echo "  Build Directory: $(BUILD_DIR)"
	@echo "  Output Directory: $(BIN_DIR)"
	@echo ""
	@echo "Library Sources:"
	@echo "$(LIB_SOURCES)" | tr ' ' '\n' | sed 's/^/  /'
	@echo ""
	@echo "Test Source:"
	@echo "  $(TEST_MAIN_SOURCE)"
	@echo ""
	@echo "Target Executables:"
	@echo "  iOS Device: $(IOS_EXECUTABLE)"
	@echo "  iOS Simulator Universal: $(SIMULATOR_UNIVERSAL_EXECUTABLE)"
	@echo "  iOS Simulator x86_64: $(X86_64_SIM_EXECUTABLE)"
	@echo "  iOS Simulator ARM64: $(ARM64_SIM_EXECUTABLE)"
	@echo "  Debug: $(DEBUG_EXECUTABLE)"